{
  "name": "jobupdate",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/generate-sitemap.js && tsc -b && vite build && copy dist\\index.html dist\\200.html && tar -a -c -f netlify-bundle.zip -C dist .",
    "lint": "oxlint",
    "preview": "vite preview",
    "scrape": "node scripts/scrape.js && node scripts/generate-sitemap.js",
    "zip": "tar -a -c -f netlify-bundle.zip -C dist ."
  },
  "dependencies": {
    "axios": "^1.18.1",
    "cheerio": "^1.2.0",
    "lucide-react": "^1.23.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "oxlint": "^1.71.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.1"
  }
}
